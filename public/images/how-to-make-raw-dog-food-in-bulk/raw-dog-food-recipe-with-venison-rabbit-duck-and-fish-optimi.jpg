 padding: 32px 28px;
 max-width: 100%;
 margin: 0;
 box-sizing: border-box;
 }
 .rmb-calc-wrap * {
 box-sizing: border-box;
 }
 .rmb-calc-badge {
 display: inline-block;
 background: #15693a;
 color: #ffffff;
 font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
 font-size: 0.72rem;
 font-weight: 700;
 letter-spacing: 0.09em;
 text-transform: uppercase;
 border-radius: 20px;
 padding: 4px 12px;
 margin-bottom: 10px;
 }
 .rmb-calc-title {
 font-family: 'Playfair Display', Georgia, serif;
 color: #15693a;
 font-size: 1.45rem;
 font-weight: 700;
 margin: 0 0 6px 0;
