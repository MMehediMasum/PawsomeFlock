    padding-top: 14px;
    padding-right: 48px;
    padding-bottom: 14px;
    padding-left: 48px;
	display: flex;
    justify-content: center;
    width: fit-content;
    margin: 0 auto;
	text-align: center;
	transition: color 0.4s ease, background 0.4s ease;
	margin-top:16px;
	margin-bottom: 24px;
}

