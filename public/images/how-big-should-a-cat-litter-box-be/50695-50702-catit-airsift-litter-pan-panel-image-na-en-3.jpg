    /* ---------- */

    .wp-block-image.is-resized img,
    .wp-block-image>.is-resized img {
        width: inherit;
        object-fit: inherit;
        aspect-ratio: inherit;
    }

    /*
figure picture {
    display: block;
}
*/

    .fancybox__nav {
        --f-button-next-pos: 0;
        --f-button-prev-pos: 0;
    }

    .catit-prod-cat__related-posts__text {
        margin-bottom: 1.5rem;
    }

    /* Icon size op 60% - pixi specs*/
    .catit-prod__img--pixi-icons {
        width: 60%
    }

    /*Icons + Store 60% - center*/

    .catit-icon--60 {
        width: 60%;
        margin-left: auto;
        margin-right: auto;
    }

    /*.catit-text--underline{
  border-bottom: 1px solid currentcolor;
	  display:block;
}*/

    .catit_prod_video_link.has-text-align-center {
        font-weight: 700;
        color: var(--link_color);
        border-bottom: 1px solid var(--gold);
        width: fit-content;
        margin: 0 auto;

    }

    .catit-cover--fixed-height picture {
        position: relative !important;
        height: 100% !important;
        display: block;
        min-width: 100%;
    }

    @media (max-width: 1024px) {
        .catit-cover--fixed-height picture {
            min-width: auto;
        }
    }

   /* @media (max-width: 1100px) {
        #right-sidebar {
            margin-top: 40px;
        }
    }*/

    /*Style.css*/
    .catit-small-line-height {
        line-height: 1.2;
    }

    .catit-list--no-margin-left {
        margin-left: 1em;
    }

    /* round corners*/
    .catit-img--border-radius img,
    .catit-img--border-radius span,
    .swiper-wrapper--slides-img-rounded .swiper-slide img {
        border-radius: 10px;
    }

    .catit-img--border-radius--top img,
    .catit-img--border-radius span {
        border-radius: 20px 20px 0 0 !important;
    }

    .catit-img--border-radius--bottom img,
    .catit-img--border-radius span {
        border-radius: 0 0 20px 20px !important;
    }

    .catit-home_hero_grid--mobile .catit-img--border-radius img,
    .catit-img--border-radius span {
        border-radius: 10px !important;
    }

    /*---*/


    /*----*/

    /* full with rows - text*/
    @media (min-width: 1025px) {
        .catit-container-content--40 {
            max-width: 512px;
        }

        .catit-container-content--50 {
            max-width: 640px;
        }

        .catit-container-content--60 {
            max-width: 768px;
        }

    }

    /*---*/



    /* Specs - products */
    .catit-prod__row--specs p,
    .catit-prod__specs__heading,
    .catit-prod__row--specs ul {
        font-size: 14px;
        color: #707070;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .catit-prod__row--specs .catit-small-margin-bottom,
    .catit-prod__specs__heading {
        color: #000;
        font-weight: 700;
        text-transform: uppercase;
    }

    /*---*/

    /*SMALL SCREENS*/
    @media (max-width: 330px) {
        .inside-navigation .navigation-branding {
            margin: 0;
        }

        .catit-menu-search__form--container {
            margin-top: 15px;
        }

        .catit-menu-search__form--container .search-submit {
            right: 10px;
        }
    }

    /*Search*/
    .catit-menu-search__favorite-results {
        margin-top: -22px;
        padding-top: 25px;
    }

    /* txt update my cat*/
    .catit-swiper-carousel-my-cat .catit-my-cat__subheading {
        text-transform: none;
        font-size: .85rem;

    }

    /* swiper products css */

    .catit-prod__swiper-wrapper {
        justify-content: left;
    }

    @media (min-width: 1024px) {
        .catit-prod__swiper-wrapper {
            justify-content: center;
        }

        .catit-swiper-carousel-prod:not(.catit-swiper-carousel-prod--5) .catit-prod__swiper-wrapper {
            justify-content: left;
        }
    }

    .catit-swiper-carousel-prod .swiper-pagination {
        position: relative;
        margin-top: 4px;
    }

    .catit-swiper-carousel-prod .catit-prod__feature {
        text-transform: capitalize;
        font-size: 0.8rem;
        margin-bottom: 5px;
        font-weight: 500;
        line-height: 1.1;
        letter-spacing: .6px;
    }

    /* ----- */


    /* SWIPER CAT PAGES*/
    .catit-prod-cat__related-posts__title {
        margin-top: 30px;
    }

    .catit-swiper-carousel-posts .catit-posts__post__info__description,
    .catit-swiper-carousel-posts .catit-posts__post__info__cta {
        display: inline-block !important;
    }

    .catit-swiper-carousel-posts .catit-posts__post__info__title {
        font-family: var(--secondary-font);
        font-size: 20px;
        color: #000;
        line-height: 1.3;
        font-weight: 400;
        margin-bottom: 0.4rem;
    }

    .catit-swiper-carousel-posts .catit-posts__post__info__meta__date {
        font-size: 12px;
        color: #838488;
        display: inline-block;
    }

    .catit-swiper-carousel-posts .catit-posts__post__info__meta__date::before {
        content: '';
        margin: 0;
    }

    .catit-swiper-carousel-posts .swiper-pagination {
        position: relative;
    }

    /* ------ */


    /* post toc update*/
    .catit-toc--update {
        margin-left: 30px;
    }

    .catit-toc--update li::marker {
        color: var(--gold);
    }


    .catit-toc--update li a,
    .catit-toc--update a {
        font-weight: 500 !important;
        color: #444 !important;
    }

    .catit-toc--update {
        font-weight: 600 !important;
    }

    .catit-toc--update li:not(:last-child) {
        margin-bottom: 5px !important;
    }

    .catit-toc--update {
        line-height: 2.4;
    }

    .catit-toc--update .catit-link-arrow a {
        text-transform: unset;
        width: auto;
        border: none !important;
        font-size: 16px;
    }

    .catit-toc--update .catit-link-arrow a:after {
        margin-top: 15px;
    }

    .catit-toc--update ul {
        list-style-type: circle;
        line-height: 1.6;
    }

    /*----*/

    .catit-accordion:after {
        margin-left: 0;
    }

/* SPOT flex V2 */
    /*
    catit-my-cat__v2-spot -> algemene class
    
    catit-my-cat__v2-spot__flex -> Flex over des+tab+mob
    catit-my-cat__v2-spot__flex--tablet -> Flex op tab + mob
    catit-my-cat__v2-spot__flex--mobile -> Flex op mob
    
    catit-my-cat__v2-spot__excerpt--hide -> Excerpt hide op alles
    catit-my-cat__v2-spot__excerpt--hide-tablet -> Excerpt hide tab+mob
    catit-my-cat__v2-spot__excerpt--hide-mobile -> Excerpt hide mob


    
    */
    
    .catit-my-cat__v2-spot .catit-metaslider__post__title {
        font-size: 19px;
    }
    
    .catit-my-cat__v2-spot__flex--mobile {
        display: flex;
    }
    
    .catit-my-cat__v2-spot__flex--mobile .catit-metaslider__post__thumbnail {
        width: 45%;
    }
    
    .catit-my-cat__v2-spot__flex--mobile .catit-metaslider__post__info {
        width: 55%;
        margin-left: 10px;
    }
    
    .catit-my-cat__v2-spot__excerpt--hide-mobile .catit-metaslider__post__excerpt,
    .catit-my-cat__v2-spot__excerpt--hide .catit-metaslider__post__excerpt {
        display: none;
    }

    
    @media (min-width: 768px) {
        .catit-my-cat__v2-spot__flex--mobile {
            display: block;
        }
        .catit-my-cat__v2-spot__flex--mobile .catit-metaslider__post__thumbnail,
        .catit-my-cat__v2-spot__flex--mobile .catit-metaslider__post__info {
            width: 100%;
            margin: 0;
        }
        .catit-my-cat__v2-spot__excerpt--hide-mobile .catit-metaslider__post__excerpt {
            display: block;
        }
        .catit-my-cat__v2-spot .catit-metaslider__post__title {
            font-size: 20px;
        }
    }
    
    @media (min-width: 1024px) {}
/*-------*/

    /* cover my cat */
    @media (max-width: 768px) {
        .catit-my-cat__hero-cover-container {
            background-image: none;
        }
    }


    /*Sticky navigation - jump mobile fix*/

    #sticky-placeholder {
        height: 50px !important;
    }

    /*----*/

    /* Magazines in form*/


    /* Submit cat form*/
    #gform_36 .catit-form__spacer {
        margin-top: 5px;
    }

    .catit-form__spacer {
        margin-top: 15px;
    }

    .catit-form_subscribe-check {
        border-radius: 10px;
        background-color: #fcf9f2 !important;
        padding: 20px !important;
        grid-column: span 12 !important;
        place-self: center;
        height: 280px;

        width: 100%;

    }

    .catit-form_subscribe-check div {
        position: relative;
        width: 100%;
    }

    .catit-form_subscribe-check div:after {
        content: "";
        background: url("https://www.catit.com/wp-content/uploads/2026/09/My-Cat-SEP-2026_Catalogs-EN.png") no-repeat;
        width: 100% !important;
        height: 190px !important;
        position: absolute;
        display: inline-block;
        top: calc(100% + 10px);
        margin-left: 0px;
        left: 0;
        background-size: contain;
        background-position: center;

    }

    #gform_36 .catit-form_subscribe-check div:after {
        height: 210px !important;
        margin-top: -7px;
    }

    .catit-form_subscribe-img {
        grid-column: span 4 !important;
        place-self: center;
    }

    .catit-form_subscribe-img img {
        width: 100%;

    }

    @media (min-width:769px) {
        .catit-form_subscribe-check {
            height: auto;
        }

        .catit-form__spacer {
            margin-top: 40px;
        }

        .catit-form_subscribe-check div {
            width: 70% !important;
        }

        .catit-form_subscribe-check div:after {
            width: 50% !important;
            top: -80px;
            margin-left: 0px;
            left: unset;
            right: unset;
        }

        .catit-form_subscribe-img img {
            width: 90%;
        }


        /* Submit cat form*/
        #gform_36 .catit-form__spacer {
            margin-top: 15px;
        }

    }

    /*------*/


    /*Arrow Button*/

    .catit-button-arrow {
        position: relative;

    }

    .catit-button-arrow a {
        padding: 7px 25px 7px 20px !important;
    }

    .catit-button-arrow a:after {
        content: " ";
        font-size: 13px;
        position: absolute;
        right: 8px;
        width: 8px;
        height: 8px;
        border-left: 2px solid var(--black);
        border-top: 2px solid var(--black);
        transform: rotate(135deg);
        top: 18px;
        border-color: #fff;
        right: 12px;

    }

    /*----*/

    /* MY CAT + general extra styling */

    @media(max-width:768px) {
        .catit-cover_my-cat {
            height: 100% !important
        }
    }

    .catit-my-cat__cta-margin {
        margin-top: 11px;
    }


    @media (max-width:1024px) {
        .catit-my-cat__text {
            padding-left: 40px;
            padding-right: 40px;
        }
    }


    @media (max-width:768px) {
        .catit-my-cat__text {
            padding-left: 16px;
            padding-right: 16px;
        }
    }

    .catit-font-500 {
        font-weight: 500;
    }

    .catit-link-simple.has-text-color a {
        color: inherit !important;
    }

    .catit-my-cat__link-custom-color.has-text-color a {
        color: inherit !important;
        font-weight: bold;
        text-decoration: underline;
        border-bottom: 0px !important;
    }


    .catit-my-cat__cat-highlight__cat-name {
        position: absolute;
        bottom: 8px;
        left: 8px;
        color: white;
        text-shadow: 0px 1px 2px black;
        margin-bottom: 0px !important;
        line-height: 1.2;
        width: 80%;
        z-index: 1;
    }

    .catit-my-cat__cat-highlight__cat-name--right {
        left: unset;
        right: 16px;
        text-align: right;
    }

    h3.catit-heading,
    .catit-heading.catit-heading--size-h3 {
        line-height: 1.2;
        margin-bottom: 10px;
    }


    /* UGC cat gallery issue fix */
    .gv-container img:not([height='854']) {
        aspect-ratio: 1/1;
        object-fit: cover;
    }

