<style>
/* General Styles */
.catit-slider__header .swiper-button {
    width: 36px;
    height: 36px;
    border-radius: 30px;
}

.catit-swiper-carousel-my-cat .catit-my-cat__subheading,
.catit-my-cat__subheading {
    text-transform: none;
    font-size: 0.85rem;
    margin-bottom: 5px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.6px;
}

h1.catit-heading,
.catit-heading.catit-heading--size-h1 {
    font-size: 36px;
}

.swiper-pagination-bullets {
    position: relative;
    margin-top: 5px;
}
@media (min-width: 1024px) {
.swiper-buttons--outside {top: 2%;}
}
.swiper-buttons--outside .swiper-button {
    margin-left: -20px;
    margin-right: -20px;
    margin-top: -35px;
}

@media (min-width: 768px) {
    .swiper-buttons--outside .swiper-button {
        margin-left: -28px;
        margin-right: -28px;
    }
}

/* Styles for Home Cover */
.catit-home__cover {
    padding-bottom: 40px !important;
}

.catit-home__cover__my-cat__logo {
    margin: auto;
    display: block;
}

.catit-home__link-button .wp-block-cover__inner-container p {
    line-height: 1;
}

.catit-home__cover p {
    font-size: 14px;
}

.catit-home__cover .catit-home__heading--h2 {
    margin-bottom: 15px !important;
}

.catit-home__cover .wp-block-button .wp-block-button__link {
    font-size: 16px !important;
    padding: 5px 36px 5px 30px !important;
}

.catit-home__cover a {
    position: relative;
}

.catit-home__cover a:after {
    content: " ";
    font-size: 13px;
    position: absolute;
    right: 12px;
    top: 16px;
    width: 8px;
    height: 8px;
    border-left: 2px solid var(--black);
    border-top: 2px solid var(--black);
    transform: rotate(135deg);
    border-color: #fff;
}

@media (min-width: 769px) {
    .catit-home__cover {
        padding-bottom: 0px !important;
        background-image: none;
    }
    .catit-home__cover .wp-block-button .wp-block-button__link {
        font-size: 16px;
    }
    .slider.slider--w-preview {
        grid-auto-columns: 95%;
    }
    .catit-home__cover p {
        font-size: 16px;
    }
}

/* Responsive Breakpoints */
@media (max-width: 370px) {
    .catit-home__link-button .wp-block-cover__inner-container p {
        font-size: 10.5px;
        padding: 8px 0;
    }
}

@media (min-width: 769px) and (max-width: 1024px) {
    .catit-home__link-button .wp-block-cover__inner-container p {
        font-size: 11.5px;
        padding: 8px 0;
    }
    .catit-home__cover p {
        font-size: 14px;
    }
    .catit-home__cover .wp-block-button .wp-block-button__link {
        font-size: 14px !important;
        padding: 3px 26px 3px 20px !important;
    }
    .catit-home__cover a:after {
        top: 12px;
    }
}

@media (min-width: 1024px) {
    .catit-home__cover .catit-home__heading--h2 {
        font-size: 36px !important;
    }
}


</style>



