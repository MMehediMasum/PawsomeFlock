document.addEventListener('DOMContentLoaded', () => {
  // Function to load images inside a menu item
  function loadMenuImages(menuItem) {
    // Load <img> tags
    menuItem.querySelectorAll('img[data-lazy-src], img:not([src])').forEach(img => {
      if (img.dataset.lazySrc) {
        img.src = img.dataset.lazySrc;
        img.removeAttribute('data-lazy-src');
      }
    });

    // Load <source> tags inside <picture>
    menuItem.querySelectorAll('picture source[data-lazy-srcset]').forEach(source => {
      source.srcset = source.dataset.lazySrcset;
      source.removeAttribute('data-lazy-srcset');
    });
  }

  // Attach hover/click event to all menu items with submenus
  document.querySelectorAll('.entry-content .menu-item').forEach(item => {
      loadMenuImages(item);
  });

  // Attach hover/click event to all menu items with submenus
  document.querySelectorAll('.menu-item-has-children').forEach(item => {
    item.addEventListener('mouseenter', () => {
      loadMenuImages(item);
    });

    // For mobile/tap menus
    item.addEventListener('touchstart', () => {
      loadMenuImages(item);
    });
  });
});

</script>
