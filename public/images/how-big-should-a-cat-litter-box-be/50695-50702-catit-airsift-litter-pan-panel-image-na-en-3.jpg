.wp-block-buttons.catit-buttons-full-mobile .wp-block-button, .wp-block-buttons.catit-buttons-full-mobile .wp-block-button a {
            width: 100%;
        }
    }

    /* HOME PRODUCT ARROWS */
    .catit-home_prod-name--arrow {
        width: 80%;
        line-height: 1.2em !important;
    }

    .catit-home_prod-name--arrow:after {

        content: ' ';
        border: 0 !important;
        font-size: 1em !important;
        position: absolute !important;
        margin-top: 2.2%;
        /* margin-left: 8px !important; */
        width: 14px !important;
        height: 9px !important;
        -webkit-mask: url(https://www.catit.com/wp-content/themes/generatepress-child/icons/Arrow-2_SVG.svg) no-repeat 50% 50%;
        mask: url(https://www.catit.com/wp-content/themes/generatepress-child/icons/Arrow-2_SVG.svg) no-repeat 50% 50%;
        -webkit-mask-size: cover;
        mask-size: cover;
        background-color: #fff;
        transform: none !important;
        /* color: #fff; */
        right: 20px;
    }

    /* REPEATER CSS*/
    .gfield_repeater_item .gfield_label {
        display: inline-block !important;
        font-size: 16px !important;
        font-weight: 700 !important;
        margin-bottom: 8px !important;
        padding: 0 !important;
        color: #000 !important;
    }

    .gfield_repeater legend {
        display: none !important;
    }

    .gfield_repeater .ginput_container input {
        width: 100% !important;
    }

    .gform_wrapper.gravity-theme .gfield_repeater_buttons .add_repeater_item_text,
    .gform_wrapper.gravity-theme .gfield_repeater_buttons .remove_repeater_item_text {
        line-height: 1 !important;
    }

    .gform_wrapper.gravity-theme .gfield_repeater_buttons .add_repeater_item_text,
    .gform_wrapper.gravity-theme .gfield_repeater_buttons .remove_repeater_item_text {
        text-transform: math-auto;
        color: #fff;
        font-weight: 700;
        border: none;
        font-size: 14px;
        line-height: 1 !important;
        padding: 10px 20px;
        height: auto;
    }

    .gform_wrapper.gravity-theme .gfield_repeater_buttons .add_repeater_item_text {
        background: var(--gold);
    }

    .gform_wrapper.gravity-theme .gfield_repeater_buttons .remove_repeater_item_text {
        background: #555;
    }


    .gform_wrapper.gravity-theme .gfield_repeater_buttons .add_repeater_item_text:hover {
        border: none;
        opacity: 0.8;
        background: var(--gold);
    }


    .gform_wrapper.gravity-theme .gfield_repeater_buttons .remove_repeater_item_text:hover {
        border: none;
        opacity: 0.8;
        background: #555;
    }

