<style>
  /* Heading */

  .catit-text--primary-font {
    font-family: var(--primary-font) !important;
  }

  .catit-prod__heading--h2--hero {
    font-size: 28px;
  }
  /* Learn more button - inactive */

  .catit-button--inactive > div:first-child a {
    opacity: 0.5;
    pointer-events: none;
    cursor: default;
  }
  /* SPECIAL FONT */

  .catit-prod__heading--ostrich {
    font-family: "Ostrich Sans Ink";
    font-weight: 500;
    letter-spacing: 2px;
    font-size: 52px;
    line-height: 57px;
  }

  .catit-prod__heading--ostrich-xl {
    font-size: 60px !important;
  }

  h2.catit-prod__heading--ostrich {
    font-size: 55px;
    line-height: 48px;
  }

  h2.catit-prod__heading--ostrich {
    font-size: 38px;
    line-height: 45px;
  }

  @media (min-width: 768px) {
    h2.catit-prod__heading--ostrich {
      font-size: 41px;
      line-height: 44px;
    }
    .catit-prod__heading--h2--hero {
      font-size: 32px;
    }
  }

  .catit-prod__heading {
    font-family: var(--secondary-font);
  }

  h3.catit-prod__heading,
  .catit-prod__heading--size-h3 {
    font-size: 24px;
    margin-bottom: 10px;
  }

  h2.catit-prod__heading,
  .catit-prod__heading--size-h2,
  h3.catit-prod__heading--size-h2 {
    font-size: 32px;
  }
  .catit-prod__heading--h2 {
    margin-bottom: 15px;
  }
  h1.catit-prod__heading,
  h2.catit-prod__heading--size-h1 {
    font-size: 32px;
    line-height: 1.1;
    margin-bottom: 10px;
  }

  h2.catit-prod__heading--xl {
    font-size: 38px;
    line-height: 1.2;
  }

  h4.catit-prod__heading,
  .catit-prod__heading--size-h4 {
    font-size: 18px;
    margin-bottom: 5px;
    line-height: 1.3;
  }

  @media (min-width: 769px) {
    h3.catit-prod__heading,
    .catit-prod__heading--size-h3 {
      font-size: 27px;
    }
    h2.catit-prod__heading,
    h3.catit-prod__heading--size-h2,
    h1.catit-prod__heading--size-h2 {
      font-size: 36px;
    }
    h2.catit-prod__heading--xl {
      font-size: 42px;
    }
    h1.catit-prod__heading,
    h2.catit-prod__heading--size-h1 {
      font-size: 38px;
    }
  }

  @media (min-width: 1024px) {
    h3.catit-prod__heading,
    .catit-prod__heading--size-h3 {
      font-size: 27px;
    }
    h2.catit-prod__heading,
    h3.catit-prod__heading--size-h2,
    h1.catit-prod__heading--size-h2 {
      font-size: 38px;
    }
    h2.catit-prod__heading--xl {
      font-size: 42px;
    }
    h1.catit-prod__heading,
    h2.catit-prod__heading--size-h1 {
      font-size: 42px;
    }
  }
  /* SWIPER */

  .catit__prod_double-fusion p,
  .catit__prod--swiper p {
    margin-bottom: 15px;
  }
  .catit__prod--swiper {
    overflow: hidden;
  }

  .catit__prod--swiper--uppercase {
    text-transform: uppercase !important;
  }

  .catit__prod--swiper .swiper-pagination-bullets {
    position: relative;
    margin-top: 25px;
  }

   .catit-swiper-in-bullets .swiper-pagination {
    margin-top: -25px;
  }
  .catit-swiper-in-bullets .swiper-pagination .swiper-pagination-bullet {
    background: #ffffff;
    opacity: 0.5;
  }
  .catit-swiper-in-bullets .swiper-pagination .swiper-pagination-bullet-active {
    background: #d4b267;
    opacity: 0.8;
  }

  .swiper-buttons--outside {
    position: absolute;
    width: -webkit-fill-available;
    top: 45%;
  }

  /* Links */
  .catit-link--dark a{
border-color:#d4b267 !important;
}
  /* BUTTONS */

  .wp-block-button .wp-block-button__link,
  .catit-prod__button .wp-block-button__link,
  .catit-prod__button--outline {
    text-transform: none !important;
    letter-spacing: 1px;
    font-size: 14px;
    border-radius: 25px !important;
    /*padding: 5px 18px;*/
  }

  .catit-prod__button--outline .wp-block-button__link {
    border: 1px solid #000;
    background-color: transparent !important;
    color: #000 !important;
  }

  .catit-prod__button--outline--white .wp-block-button__link {
    border: 1px solid #fff;
    background-color: transparent !important;
    color: #fff !important;
  }

  .catit-prod__button--outline .wp-block-button__link:hover {
    transition: opacity 0.3s;
    opacity: 0.7;
  }

  .catit-prod__flex--cuisine-eu .catit-product__buttons-buy a {
    border: solid #000 1px;
  }
  /* SUBHEADING */

  .catit-prod__subheading {
    font-weight: 700;
    letter-spacing: 1.5px;
    font-size: 13px !important;
    text-transform: uppercase;
    padding-bottom: 5px;
    line-height: 1;
  }

  /* NAV PROD */

  .catit-prod-nav__dropdown--content---title:not(:first-child) {
    margin-top: 15px;
  }

  .catit-prod-nav__dropdown--content--spacer {
    padding: 0 !important;
    min-height: 30px !important;
    border: none !important;
  }

  .catit-prod-nav__dropdown--content ul li a,
  .catit-prod-nav__dropdown--content ul li span {
    display: block;
    width: 100%;
  }

  .catit-cover-grid__item p {
    font-size: 17px;
    line-height: 1.3;
  }

  .catit-cover-grid__item p:first-child {
    font-size: 26px;
    padding-bottom: 10px;
  }

  @media (min-width: 768px) {
    .catit-cover-grid__item p:first-child {
      font-size: 26px;
    }
  }

  .catit-cover-grid__item .wp-block-buttons {
    margin-top: 15px;
  }

  .catit-cover-grid__item p {
    margin-top: 8px;
    margin-bottom: 15px;
  }

  @media (min-width: 768px) {
    .catit-cover-grid__item h3 {
      font-size: 24px;
    }
  }

  @media (min-width: 768px) {
    html[lang="fr-CA"]
      .catit-prod__flex__container
      .wp-block-button
      .wp-block-button__link,
    html[lang="fr-FR"]
      .catit-prod__flex__container
      .wp-block-button
      .wp-block-button__link {
      font-size: 12px;
    }
  }

  .catit-cover-grid .catit-product__buttons-buy a {
    border: solid 1px black;
  }
  /* OVERVIEW TXT SIZE */
  /*
.catit-prod__flex
.catit-prod__flex__container
*/
  /*Desktop*/

  .catit-prod__flex .catit-prod__flex__container p {
    font-size: 15px;
    line-height: 1.3;
    margin-top: 4px;
    margin-bottom: 15px;
  }

  .catit-prod__flex .catit-prod__flex__container p:first-child {
    font-size: 24px;
    padding-bottom: 10px;
  }
  /* -- List update -- */

  .catit-prod__flex ul {
    list-style: none;
    padding: 0;
    margin: 0;
    /*display: flex;*/
    /*justify-content: center; */
    /* centers the whole list */
    /*gap: 0;*/
    text-align: center;
    /* centers text inside items */
    /*flex-wrap:wrap;*/
    line-height: 1.3;
  }

  .catit-prod__flex ul li {
    /* width: min-content;*/
    /*  white-space: nowrap;*/
    display: inline;
    font-size: 15px;
    font-weight: 500;
  }

  .catit-prod__flex ul li:not(:first-child)::before {
    content: " | ";
    /* dash with spaces */
  }
  /*  .catit-prod__flex ul li:not(:last-child)::after {
  content: " ";   
  content: "\00a0";           
}*/

  @media (min-width: 768px) {
    .catit-prod__flex .catit-prod__flex__container p:first-child {
      font-size: 26px;
    }
  }

  .catit-prod__flex .catit-prod__flex__container .wp-block-buttons {
    margin-top: 12px;
  }

  @media (min-width: 768px) {
    .catit-prod__flex .catit-prod__flex__container h3 {
      font-size: 26px;
    }
    .catit-prod__flex .catit-prod__flex__container h3:lang(es-ES),
    .catit-prod__flex .catit-prod__flex__container h3:lang(pl-PL),
    .catit-prod__flex .catit-prod__flex__container h3:lang(pt-PT) {
      font-size: 22px;
      line-height: 1.1;
    }
  }

  @media (min-width: 1024px) and (max-width: 1300px) {
    .catit-swiper .catit-prod__flex__container h3 {
      font-size: 23px;
    }
    .catit-swiper .catit-prod__flex__container ul li {
      font-size: 14px;
    }
    .catit-swiper .catit-prod__flex__container .wp-block-buttons {
      margin-top: 7px;
    }
  }
  /* -- Reviews -- */

  .catit-review .catit-review-name {
    font-size: 14px;
    font-style: italic;
  }

  .catit-review {
    background-color: #fdf8f1;
    /*box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;*/
    padding: 15px;
    font-size: 15px;
    border-radius: 10px;
  }

  .catit-desc-truncated,
  .catit-desc-full {
    display: inline;
  }

  .catit-review .catit-paw {
    margin-right: 5px;
  }
