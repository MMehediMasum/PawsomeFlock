        text-transform: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0;
    }

    /* HOME GRID*/
    .catit-home_hero_grid img {
        transition: all .2s ease-in-out;
        -webkit-transition: all .2s ease-in-out;
        -moz-transition: all .2s ease-in-out;
        -o-transition: all .2s ease-in-out;
    }

    .catit-home_hero_grid img:hover {
        transform: scale(.985);

    }

    .catit-home_hero_grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: repeat(5, min-content);
        grid-column-gap: 1vw;
        grid-row-gap: 1vw;
    }

    @media(min-width:1280px) {
        .catit-home_hero_grid {
            grid-column-gap: 16px;
            grid-row-gap: 16px;
        }
    }

    .catit-home_hero_grid .catit-home_hero_grid_container-1 {
        grid-area: 1 / 1 / 4 / 5;
    }

    .catit-home_hero_grid .catit-home_hero_grid_container-2 {
        grid-area: 1 / 5 / 6 / 7;
    }

    .catit-home_hero_grid .catit-home_hero_grid_container-3 {
        grid-area: 4 / 1 / 6 / 3;
        align-self: end;
    }

    .catit-home_hero_grid .catit-home_hero_grid_container-4 {
        grid-area: 4 / 3 / 6 / 5;
        align-self: end;
    }

