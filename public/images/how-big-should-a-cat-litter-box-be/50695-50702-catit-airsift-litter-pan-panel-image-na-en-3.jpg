</style>    <meta name="ps-key" content="6826-68c9a8f43fcea0bd265f0029">
    <meta name="ps-country" content="CA">
    <meta name="ps-language" content="en">
    <script nowprocket>
        (function () {

            function getCookie(name) {
                return document.cookie
                    .split('; ')
                    .find(row => row.startsWith(name + '='))
                    ?.split('=')[1] || null;
            }

            var country = getCookie('catit_store');

            // Country source: `geot_country_cookie` global variable (set elsewhere)

            var isUS = country === 'US';
            console.log('Detected country:', country);

            var countryCode = isUS ? 'US' : 'CA';

            function upsertMeta(name, content) {
                var m = document.querySelector('meta[name="' + name + '"]');
                if (m) m.setAttribute('content', content);
                else {
                    m = document.createElement('meta');
                    m.name = name;
                    m.content = content;
                    document.head.appendChild(m);
                }
            }
            if (countryCode !== 'CA') {
                upsertMeta('ps-country', countryCode);
            }

        })();
    </script>
