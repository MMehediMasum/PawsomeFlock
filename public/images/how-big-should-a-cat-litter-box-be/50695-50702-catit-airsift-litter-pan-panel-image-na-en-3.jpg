        width: calc(100% + 40px);
    }

    .catit-menu-bol a:before {
        content: '•';
        padding-right: 5px;
    }

    .catit-menu-text--large-line-height a {
        line-height: 1.6em !important;
    }

    .catit-accordion-no-plus:after {
        content: "";
    }

    .catit-store__online-store-btn {
        display: block;
        border: 1px solid var(--contrast-3);
        padding: 16px 20px;
        border-radius: 20px;
    }

