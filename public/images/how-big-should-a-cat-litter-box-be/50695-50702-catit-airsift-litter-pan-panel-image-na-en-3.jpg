.catit-cover--2--hide--tablet            
.catit-cover--2--hide--desktop  

*/

/* MOBILE */

@media (max-width: 768px) {
    .catit-cover--2--fixed-height--mobile {
      padding: 0 !important;
      min-height: unset !important;
    }
  
    .catit-cover--2--fixed-height--mobile picture {
      position: relative !important;
      height: 100% !important;
      display: block;
      min-width: 100%;
    }
  
    .catit-cover--2--fixed-height--mobile img {
      position: relative !important;
      height: 100% !important;
      display: block;
    }
  
    .catit-cover--2--fixed-height--mobile .wp-block-cover__inner-container {
      position: absolute;
      width: 100% !important;
    }
  
    .catit-cover--2--hide--mobile {
      min-height: auto !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
padding: 0 !important;
    }
  
    .catit-cover--2--hide--mobile > picture > .wp-block-cover__image-background {
      display: none !important;
    }
  }

  /* TABLET */

  @media (min-width: 769px) and (max-width: 1024px) {
    .catit-cover--2--fixed-height--tablet {
      padding: 0 !important;
      min-height: unset !important;
    }
  
    .catit-cover--2--fixed-height--tablet picture {
      position: relative !important;
      height: 100% !important;
      display: block;
      min-width: 100%;
    }
  
    .catit-cover--2--fixed-height--tablet img {
      position: relative !important;
      height: 100% !important;
      display: block;
    }
  
    .catit-cover--2--fixed-height--tablet .wp-block-cover__inner-container {
      position: absolute;
      width: 100% !important;
    }
  
    .catit-cover--2--hide--tablet:not(.catit-cover--2--fixed-height--mobile) {
      min-height: auto !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  
    .catit-cover--2--hide--tablet > picture > .wp-block-cover__image-background {
      display: none !important;
    }
  }
 
  /* DESKTOP */

  @media (min-width: 1025px) {
    .catit-cover--2--fixed-height--desktop:not(.catit-cover--2--fixed-height--mobile) {
      padding: 0 !important;
      min-height: unset !important;
    }
  
    .catit-cover--2--fixed-height--desktop picture {
      position: relative !important;
      height: 100% !important;
      display: block;
      min-width: 100%;
    }
  
    .catit-cover--2--fixed-height--desktop img {
      position: relative !important;
      height: 100% !important;
      display: block;
    }
  
    .catit-cover--2--fixed-height--desktop .wp-block-cover__inner-container {
      position: absolute;
      width: 100% !important;
    }
  
    .catit-cover--2--hide--desktop:not(.catit-cover--2--fixed-height--mobile) {
      min-height: auto !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  
    .catit-cover--2--hide--desktop > picture > .wp-block-cover__image-background {
      display: none !important;
    }
  }
