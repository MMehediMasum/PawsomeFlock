document.addEventListener("DOMContentLoaded", function () {
	const btn1 = document.querySelector(".footer-widget-4 .widget-title");
	const btn2 = document.querySelector(".footer-widget-2 .widget-title");
	var btn3 = document.querySelector(".footer-widget-3 .widget-title");

	const targetDiv1 = document.querySelector(".footer-widget-4 div");
	const targetDiv2 = document.querySelector(".footer-widget-2 div");
	var targetDiv3 = document.querySelector(".footer-widget-3 div");

	if (geot_country_cookie === "GB") {
		btn3 = document.querySelector(".footer-widget-3 #nav_menu-67 .widget-title");
		targetDiv3 = document.querySelector(".footer-widget-3 #nav_menu-67 div");

	}

	if (geot_country_cookie === "US") {
		btn3 = document.querySelector(".footer-widget-3 #nav_menu-66 .widget-title");
		targetDiv3 = document.querySelector(".footer-widget-3 #nav_menu-66 div");

	}

	/* targetDiv1.style.display = "none";
	targetDiv2.style.display = "none";
	targetDiv3.style.display = "none";
	targetDiv1.classList.add("hide");
	targetDiv2.classList.add("hide");
	targetDiv3.classList.add("hide"); */

	btn1.onclick = function () {
		if (targetDiv1.classList.contains("show")) {
			targetDiv1.classList.remove("show");
		} else if (!targetDiv1.classList.contains("show")) {
			targetDiv1.classList.add("show");
		}
	};

	btn3.onclick = function () {
		if (targetDiv3.classList.contains("show")) {
			targetDiv3.classList.remove("show");
		} else if (!targetDiv3.classList.contains("show")) {
			targetDiv3.classList.add("show");
		}
	};

	btn2.onclick = function () {
		if (targetDiv2.classList.contains("show")) {
			targetDiv2.classList.remove("show");
		} else if (!targetDiv2.classList.contains("show")) {
			targetDiv2.classList.add("show");
		}
	};
});
