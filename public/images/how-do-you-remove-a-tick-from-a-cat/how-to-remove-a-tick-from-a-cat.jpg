<script defer src="data:text/javascript,window.uetq%20%3D%20window.uetq%20%7C%7C%20%5B%5D%3B%0D%0Awindow.uetq.push%28%27event%27%2C%20%27purchase%27%2C%20%7B%0D%0A%20%20%20%20%27revenue_value%27%3A%20%3C%3Fphp%20echo%20%24order-%3Eget_total%28%29%3B%20%3F%3E%2C%0D%0A%20%20%20%20%27currency%27%3A%20%27%3C%3Fphp%20echo%20%24order-%3Eget_currency%28%29%3B%20%3F%3E%27%0D%0A%7D%29%3B"></script><style id="wp-custom-css">/* Accessibility: Hide skip links until focused */
.screen-reader-text {
    border: 0;
    clip: rect(1px, 1px, 1px, 1px);
    clip-path: inset(50%);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    width: 1px;
    word-wrap: normal !important;
}

/* Make them visible and usable on Tab focus */
.screen-reader-text:focus {
    background-color: #eee;
    border-radius: 3px;
    box-shadow: 0 0 2px 2px rgba(0, 0, 0, 0.6);
    clip: auto !important;
    clip-path: none !important;
    color: #444;
    display: block;
    font-size: 1em;
    height: auto;
    left: 5px;
    padding: 15px 23px 14px;
    position: absolute;
    top: 5px;
    width: auto;
    z-index: 100000;
}

/* Universal Focus Indicator for all interactive elements */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[tabindex]:focus-visible {
    outline: 3px solid #109cde !important;
    outline-offset: 2px !important;
   
}




/* 1. Ensure the parent container allows absolute positioning */
li.product {
    position: relative;
}

/* 2. The Invisible Overlay */
.full-card-link-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    cursor: pointer;
}

/* 3. Make internal content "reach-through" to the mouse */
/* This allows the screen reader to focus on elements individually */
li.product > *:not(.full-card-link-overlay) {
    position: relative;
    z-index: 5;
    pointer-events: none; /* Mouse passes through to the overlay */
}

/* 4. Keep "Add to Cart" button clickable */
li.product .button, 
li.product .add_to_cart_button {
    pointer-events: auto; /* Click works on the button */
    z-index: 20; /* Above the overlay */
}

.trf-product-colors-holder {
    padding-top: 10px !important;
    /* padding-bottom: 20px !important; */
    height: 50px !important;
}



/* Force minimum 14px font size in the footer for accessibility */
footer p, 
footer a, 
footer span, 
footer li, 
footer div,
[role="contentinfo"] p,
[role="contentinfo"] a,
[role="contentinfo"] span,
[role="contentinfo"] li,
[role="contentinfo"] div {
    font-size: 14px !important;
line-height: 20px !important;
}

/* Exclude icon fonts (like FontAwesome) so their sizing doesn't break */
footer i, 
footer [class*="icon"], 
[role="contentinfo"] i, 
[role="contentinfo"] [class*="icon"],
footer svg,
[role="contentinfo"] svg {
    font-size: inherit !important;
}




.back-to-top {
    position: fixed;
    bottom: 70px;
    right: 20px;
    display: none; /* Hidden by default */
    background-color: #a52727;
    color: #fff;
    border: none;
 //   padding: 15px;
padding-left:15px;
padding-right:15px;
padding-top:10px;
padding-bottom:10px;
    cursor: pointer;
    border-radius: 50%;
    z-index: 9999;
}

.back-to-top.visible {
    display: block;
}

.back-to-top:focus {
    outline: 3px solid #007bff;
}


/* Uniquely targets the h3 elements inside the 'Why The Refined Feline' block */
.wc-single-why-trf h3.why-trf-title {
    /* Add your custom styles here */
    font-size: 16px !important;
  font-family:inter !important;
    font-weight: 700 !important;
}

/* Uniquely targets the 'Add a photo' button in the Customer Photos section */
.wc-single-customer-photos .block-section-title .customer-photos-upload-button
{
margin-bottom: 16px !important;
}


.trf-archive-navigation .trf-blog-search-form .trf-blog-search-submit {
  
    margin-top: 8px !important;
}
.trf-archive-navigation .trf-archive-filters {
    padding-top: 12px !important;
}



/* ==========================================================================
   Mobile Menu Accessibility - Screen Reader Close Button (Based on Skip Links)
   ========================================================================== */

/* 1. Hiding logic perfectly matched to your proven screen-reader-text CSS */
button.sr-only-close-btn:not(:focus) {
    border: 0 !important;
    clip: rect(1px, 1px, 1px, 1px) !important;
    clip-path: inset(50%) !important;
    height: 1px !important;
    margin: -1px !important;
    overflow: hidden !important;
    padding: 0 !important;
    position: absolute !important;
    width: 1px !important;
    word-wrap: normal !important;
    
    /* Extra failsafes against aggressive theme button styling */
    background: transparent !important;
    color: transparent !important;
    min-width: 0 !important;
    min-height: 0 !important;
}

/* 2. Focus styling matching your skip links, but positioned at the bottom of the nav */
button.sr-only-close-btn:focus {
    background-color: #eee !important;
    border-radius: 3px !important;
    box-shadow: 0 0 2px 2px rgba(0, 0, 0, 0.6) !important;
    clip: auto !important;
    clip-path: none !important;
    color: #444 !important;
    display: block !important;
    font-size: 1em !important;
    height: auto !important;
    padding: 15px 23px 14px !important;
    
    /* Layout specific for the bottom of the mobile menu */
    position: static !important; 
    width: 80% !important;
    margin: 20px auto !important;
    z-index: 100000 !important;
    text-align: center !important;
    cursor: pointer !important;
}







/* ==========================================================================
   Header Banner Accessibility - Button Reset
   ========================================================================== */
button.header-top-banner-cta {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    color: inherit; /* Inherits the text color from the header */
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    cursor: pointer;
    text-decoration: underline; /* Optional: Good for links/buttons in text */
}

/* Add a visual focus outline for keyboard users */
button.header-top-banner-cta:focus-visible {
    outline: 2px solid #ffffff; /* Adjust color to match your header */
    outline-offset: 4px;
    border-radius: 2px;
}

/* Hide the Google reCAPTCHA v3 floating badge */
.grecaptcha-badge {
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
}


/*--Colour Contrast--*/
.trf-judge-me-verified{
color: #333 !important;
}

.trf-sliding-cta-text{
color: #333 !important;
}
