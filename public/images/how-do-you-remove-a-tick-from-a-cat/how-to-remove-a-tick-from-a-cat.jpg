}

.jdgm-rev-widg__sort-wrapper {
    float: right;
}

.jdgm-form {
    margin: 0 auto;
    padding: 0 16px;
    max-width: 600px;
}

.woocommerce-cart .shop_table .fee{
		display: none;
}

.trf-guarantee-image img{
		width: 80%;
}

.woocommerce div.product form.cart .variations tr{
		flex: 1 1 100%!important;
}

.woocommerce div.product form.cart .reset_variations{
		display: none!important;
    visibility: hidden!important;
}


.trf-wc-categories .trf-wc-category:last-child{
	margin: 0 auto;
	margin-bottom: 72px;
}

.trf-attributes-custom-display .trf-attributes-thumbs-wrap{
	display: none;
}

.product-template-default .woocommerce-notices-holder h1, .woocommerce-account .mainer h1, .post-template-default .mainer__holder h1{
	display: none;
}

.page-id-80627 .mainer__holder h1{
	display: none;
}

