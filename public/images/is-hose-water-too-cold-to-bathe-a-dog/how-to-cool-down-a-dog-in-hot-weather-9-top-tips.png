    <!-- There is no amphtml version available for this URL. --><style id="wp-custom-css">

@media (max-width: 600px) {
   .menu-sec {
  background:transparent;
}
	.lihalf li{width:100% !important;
	float:none !important;
	}
	  .container {
    padding: 0px !important;
  }
	.header-content .header-right{padding-right: 80px !important;}
	.header-content .header-left{margin-left:15px;}
}
.pearland-strip::after {
	width: 100%;
}
.pearland-strip{
	overflow:hidden;
}
.pearlandclinic::after {
	position: absolute;
	background-color: #FAFFEF;
	content: '';
	width: calc(100% - 15px);
	height: calc(100% + 100px);
	top: -20px;
}
.pearlandclinic .img-box, .pearlandclinic .heading-txt,
.pearlandclinic .btn{
	z-index:9;
}
.dogstent .img-box img{
	    transform: scaleX(-1);
}
.pearland-strip .heading-txt {
	float: initial;
	width: 100%;
}
.pearland-strip-box .txt-btn-wrapper {
	z-index: 9;
}
.pearland-strip-box .txt-btn-wrapper a{
	margin-left: 0px;
	margin-top: 10px;
}
.etmribox, .pearlandclinic {
	font-size: 20px;
}
.pearland-strip .img-box img {
	margin-right: 20px;
}
.pearland-strip-box .txt-btn-wrapper a{
	text-align: center;
}

@media (max-width:1199px){
	.etmribox, .pearlandclinic {
		font-size: 18px;
	}
}
@media (max-width:991px){
	.pearlandclinic::after {
		width: calc(100% + 35px);
		height: 100%;
		left: -20px;
		top: 0;
	}
	.pearlandclinic .img-box,
	.pearland-strip-box .txt-btn-wrapper{
		padding-top:20px;
		padding-bottom:20px;
	}
		.etmribox .txt-btn-wrapper{
		padding-top:0px;
	}
	.etmribox.dogstent .txt-btn-wrapper{
		margin-bottom: 0px;
		padding-bottom:0px;
		padding-top:20px;
	}
}
@media (max-width: 767px) {
  .pearlandclinic {
    margin-top: 0px !important;
  }
}
@media (max-width: 500px) {
  .etmribox .btn-style, .pearlandclinic .btn-style {
    margin-left: 0px !important;
  }
}

.wp-singular.sidebar .right_band,.post-type-archive-ourteam.sidebar .right_band
{position: sticky;
  top: 80px;}


.single-post .entry-content ol li{color: gray !important;}
.single-post .entry-content ol li::marker{
	color:#0b70aa !important;
}


/*summer form */
.mt-3 {
    margin-top: 15px;
}

.h-box1 {
    background-color: #317CBE;
    color: #fff;
    padding: 20px 100px;
    border-radius: 20px;
    margin-top: 20px;
    display: inline-block;
    font-size: 30px;
    font-weight: bold;
    letter-spacing: 0.3em;
    position: relative;
}

.h-box1::after {
    content: "";
    position: absolute;
    top: 0;
    right: -20px;
    transform: translateY(-40%);
    width: 85px;
    height: 85px;
    background: url('https://www.safarivet.com/wp-content/uploads/2026/05/popcorn.svg') no-repeat center center;
    background-size: contain;
}

.h-box1::before {
    content: "";
    position: absolute;
    bottom: -36px;
    left: -27px;
    width: 100px;
    height: 100px;
    background: url('https://www.safarivet.com/wp-content/uploads/2026/05/ticket.svg') no-repeat center center;
    background-size: contain;
}

.cinema-page-header {
    background: url('https://www.safarivet.com/wp-content/uploads/2026/05/banner-paw.svg');
    background-position: 5% 0;
    background-repeat: no-repeat;

}

.banner-content-box {
    padding: 0 20%;
    color: #317CBE;
    font-size: 24px;
    position: relative;
}

.banner-content-box::after {
    content: "";
    position: absolute;
    top: calc(50% - 75px);
    right: 0;
    width: 150px;
    height: 150px;
    background: url('https://www.safarivet.com/wp-content/uploads/2026/05/banner-pear.svg') no-repeat center center;
    background-size: contain;
}

.green-text {
    color: #7B8C2A;
}

.yellow-text {
    color: #E8A020;
}

.c-banner-title {
    font-size: 63px;
    font-weight: normal;
    color: #317CBE;
    padding: 15px 0;
}

.badge-boxes {
    display: flex;
    gap: 20px;
    margin-top: 20px;
    justify-content: center;
}

.badge-boxes>div {
    background-color: #317CBE;
    color: #fff;
    padding: 10px 20px;
    border-radius: 10px;
    font-size: 28px;
    width: 100%;
}

.badge-boxes>div small {
    font-size: 16px;
    display: block;
    margin-top: 5px;
}

.cat-streep {
    background-color: #A2AF1F;
    color: #fff;
    font-size: 25px;
    padding: 20px 0;
    margin-top: 30px;
}

.text-underline {
    text-decoration: underline;
}

.c-cta-box {
    display: flex;
}

.row3-heading {
    font-size: 28px;
    letter-spacing: 0.15em;
    color: #317CBE;
    padding: 20px 35px;
}

.c-help-title {
    font-size: 20px;
    color: #317CBE;
    font-weight: bold;
    text-decoration: underline;
    padding: 20px 35px;
    position: relative;
}

.c-help-title:before {
    content: "";
    position: absolute;
    top: 0;
    left: calc(50% - 25%);
    width: 50%;
    height: 5px;
    border-radius: 15px;
    background-color: #317CBE;
}

.c-row3 {
    position: relative;
    background: url('https://www.safarivet.com/wp-content/uploads/2026/05/footer-paw.svg') no-repeat 90% bottom;
    background-size: auto 350px;
    padding-bottom: 30px;
    padding-top: 15px;

}

.c-phone-cta {
    background-color: #317CBE;
    color: #fff;
    padding: 10px 20px;
    border-radius: 50px;
    font-size: 28px;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    position: relative;

}

.c-phone-cta:hover {
    color: #fff;
}

.c-phone-cta::before {
    content: "";
    position: absolute;

    background: url('https://www.safarivet.com/wp-content/uploads/2026/05/footer-pear.svg') no-repeat;
    background-size: contain;
    width: 160px;
    height: 160px;
    top: 30px;
    left: -110px;
    transform: translate(-50%, -50%);
}

.hours-of-operation-container {
    background-color: #317CBE;
    color: #fff;
    padding: 15px;
    border-radius: 20px;
    margin-top: 50px;
    max-width: 700px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
}

.hours-of-operation>div {
    display: flex;
    gap: 20px;
    margin-top: 10px;
    justify-content: space-between;
    font-size: 20px;
}

.hours-of-operation>div p {
    margin: 0;
}

.form-action-wrapper {
    background-color: #A2AF1F;
    margin-top: 20px;
    padding: 20px;
}

.c-footer-wrapper {
    background-color: #A2AF1F;
    color: #fff;
    padding: 20px 0;
    text-align: center;
    font-size: 22px;
}

.hours-of-operation-container h3 {
    margin-top: 0;
}

.c-footer-links {
    display: flex;
    gap: 30px;
    justify-content: center;
}

.c-footer-links a {
    color: #317CBE;
    margin-top: 10px;
    text-decoration: none;
}



/*Thank You */
.paw-left {
    position: absolute;
    top: 100px;
    left: 20px;
    width: 80px;
    opacity: .1;
}

.paw-right {
    position: absolute;
    top: 100px;
    right: 20px;
    width: 80px;
    opacity: .1;
}



.check-circle {
    width: 100px;
    height: 100px;
    margin: auto;
    background: #a3bb1e;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 70px;
    color: white;
    margin-bottom: 20px;
    margin-top: 25px;
}

.title {
    text-align: center;
    font-size: 55px;
    font-weight: 700;
    color: #2a67b5;
    margin-bottom: 15px;
}

.subtitle {
    text-align: center;
    font-size: 20px;
    margin-bottom: 50px;
}

.subtitle span {
    font-weight: 600;
    color: #2a67b5;
}

/* Voucher */

.voucher {
    background: #fff;
    border-radius: 25px;
    padding: 35px;
    position: relative;
    margin-bottom: 35px;
}

.voucher-header {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    gap: 20px;
}

.voucher-header h3 {
    color: #2a67b5;
    font-size: 20px;
    font-weight: 700;
}

.small-icon {
    width: 75px;
}

.code-box {
    background: #d6f5d5;
    border: 2px dashed #2a67b5;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
    margin-bottom: 30px;
}

.voucher-code {
    font-size: 40px;
    font-family: monospace;
    font-weight: bold;
    letter-spacing: 4px;
    color: #2a67b5;
}

.details {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
}

.item {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 18px;
}

.item img {
    width: 30px;height: auto;
}

/* Tip box */
.logo-wrapper img {
    max-width: 98%;height: auto;
}

.tip {
    background: #d3e8f9;
    padding: 30px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
}

.tip img {
    width: 70px;height: auto;
}

.tip p {
    font-size: 20px;
    line-height: 1.6;
}

/* Call */

.call {
    text-align: center;
    margin-bottom: 30px;
}

.call h4 {
    color: #2a67b5;
    font-size: 30px;
    margin-bottom: 20px;
}

.call-btn {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    padding: 18px 45px;
    border-radius: 60px;
    background: #2a67b5;
    color: white;
    text-decoration: none;
    font-size: 32px;
    font-weight: 600;
}

.call-btn img {
    width: 30px;height: auto;
    filter: brightness(0) invert(1);
}

.footer {
    text-align: center;
    margin-top: 30px;
    font-size: 22px;
    line-height: 1.7;
    color: #2a67b5;
}

@media(max-width:768px) {

    .container {
        padding: 30px;
    }

    .title {
        font-size: 40px;
    }

    .subtitle {
        font-size: 18px;
    }

    .details {
        grid-template-columns: 1fr;
        text-align: left;
    }

    .voucher-code {
        font-size: 28px;
    }

    .call-btn {
        font-size: 22px;
        padding: 15px 25px;
    }

}


@media screen and (max-width: 991px) {

    .c-phone-cta::before,
    .banner-content-box::after,
    .c-row3,
    .cinema-page-header {
        background: none;
    }

    .c-footer-links {
        flex-direction: column;
        gap: 10px;
    }

    .banner-content-box {
        padding: 20px;
    }

    .c-banner-title {
        font-size: 50px;
    }
}

@media screen and (max-width: 680px) {
    .c-banner-title {
        font-size: 40px;
    }

    .badge-boxes {
        flex-direction: column;
        gap: 10px;
    }

    .h-box1 {
        font-size: 20px;
        padding: 20px 70px;
    }

    .cinema-page-header img {
        max-width: 98%;
    }

    .h-box1::before {
        bottom: -25px;
        left: -7px;
        width: 80px;
        height: 80px;
    }

    .h-box1::after {
        right: 2px;
        width: 65px;
        height: 65px;
    }

    .details {
        justify-content: start;
    }

    .voucher-code {
        font-size: 20px;
    }
}

@media screen and (max-width: 400px) {

    .tip {
        flex-direction: column;
        justify-content: center;
    }

    .hours-of-operation>div {
        flex-direction: column;
        gap: 5px;
        justify-content: start;
        align-items: start;
    }

    .title {
        font-size: 30px;
    }

    .voucher {
        padding: 15px;
    }

    .voucher-code {
        font-size: 16px;
        font-weight: 700;
    }


}

.summer-main-wrapp{margin: 0;
    padding: 0;
    background-color: #EBF6FF;}
</style>
