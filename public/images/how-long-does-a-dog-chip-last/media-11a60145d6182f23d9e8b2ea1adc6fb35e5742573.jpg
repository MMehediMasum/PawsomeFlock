              <div class="adoption-fast-mobile-menu-actions">
                <button id="adoption-fast-mobile-search" class="adoption-fast-mobile-search" type="button" aria-label="Open search">
                  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-4-4"></path>
                  </svg>
                </button>
                <a class="adoption-fast-sign-in" href="/sign-in">Sign in</a>
