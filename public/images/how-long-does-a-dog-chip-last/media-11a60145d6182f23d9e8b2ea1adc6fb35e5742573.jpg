              <a class="adoption-fast-mobile-menu-link" href="/pet-adoption"><span>Adopt</span><span class="adoption-fast-mobile-menu-chevron" aria-hidden="true">&#8250;</span></a>
              <a class="adoption-fast-mobile-menu-link" href="/pet-protection"><span>Protect</span><span class="adoption-fast-mobile-menu-chevron" aria-hidden="true">&#8250;</span></a>
              <a class="adoption-fast-mobile-menu-link" href="/care"><span>Care</span><span class="adoption-fast-mobile-menu-chevron" aria-hidden="true">&#8250;</span></a>
              <a class="adoption-fast-mobile-menu-link" href="/about-us"><span>About</span></a>
              <a class="adoption-fast-mobile-report" href="/report-lost-or-found-pet">Report a lost or found pet</a>
            </nav>
          </div>
          <div id="adoption-fast-banner" class="adoption-fast-banner">
            <div class="adoption-fast-banner-inner">
              <p class="adoption-fast-banner-title">The 24Petwatch microchip registry is now on PetPlace!</p>
              <a class="adoption-fast-help" href="tel:18337387523">
                <span>Need Help? Call 1-833-738-7523.</span>
                <span aria-hidden="true">&#8594;</span>
              </a>
              <button id="adoption-fast-banner-close" class="adoption-fast-banner-close" type="button" aria-label="Close banner">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                  <path d="M6 6l12 12M18 6 6 18"></path>
                </svg>
              </button>
            </div>
          </div>
        </header>
        <div id="adoption-fast-search-overlay" class="adoption-fast-search-overlay" role="dialog" aria-modal="true" aria-label="Search" hidden>
          <div class="adoption-fast-search-dialog">
            <form class="adoption-fast-search-form" role="search" action="/search" method="get">
              <input class="adoption-fast-search-input" aria-label="Search PetPlace" name="query" type="search" placeholder="Search PetPlace">
              <button class="adoption-fast-icon-button" style="position:absolute;right:4px;top:4px" type="submit" aria-label="Submit search">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-4-4"></path>
                </svg>
              </button>
            </form>
            <button id="adoption-fast-search-close" class="adoption-fast-icon-button" type="button" aria-label="Close search">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M6 6l12 12M18 6 6 18"></path>
              </svg>
            </button>
          </div>
        </div>
        <main class="adoption-detail-only">
          <section class="adoption-fast-main">
            <div class="adoption-fast-container">
              <div id="adoption-hero-root" class="adoption-fast-hero">
                <img
                  id="adoption-hero-image"
                  src="/images/adoption-paw-placeholder.webp"
                  alt="Pet available for adoption"
                  width="800"
                  height="600"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                >
              </div>
              <div id="adoption-content-root">
                <div class="adoption-fast-info"></div>
              </div>
            </div>
          </section>
        </main>
        <div id="adoption-below-fold-root" class="adoption-detail-only"></div>
        <div id="adoption-search-content-root" class="adoption-search-only">
          <main>
          <section class="adoption-search-controls">
            <div id="adoption-search-controls-root">
              <div class="adoption-search-loading-form" role="status" aria-label="Loading pet search controls" data-adoption-search-parser-loading>
                <div class="adoption-search-loading-fields" aria-hidden="true">
                  <div class="adoption-search-loading-field"><span class="adoption-search-loading-label"></span><span class="adoption-search-loading-control"></span></div>
                  <div class="adoption-search-loading-field"><span class="adoption-search-loading-label"></span><span class="adoption-search-loading-control"></span></div>
                  <div class="adoption-search-loading-field"><span class="adoption-search-loading-label"></span><span class="adoption-search-loading-control"></span></div>
                </div>
                <span class="adoption-search-loading-button" aria-hidden="true"></span>
              </div>
            </div>
          </section>
          <section class="adoption-search-results">
            <div class="adoption-search-results-layout">
              <div id="adoption-search-filters-root" class="adoption-search-filters-root"></div>
              <div class="adoption-search-results-main">
                <div id="adoption-search-heading-root">
                  <div class="adoption-search-heading-row" data-adoption-search-parser-loading>
                    <h1 id="adoption-search-heading" class="adoption-search-heading heading-xs title-serif text-brand-secondary-800">Dogs for adoption near 90210</h1>
                    <div class="adoption-search-sort-row"><span class="adoption-search-filter-placeholder">Filter</span><span>Sorted by: Nearest</span></div>
                  </div>
                </div>
                <div class="adoption-search-grid">
                  <section id="adoption-search-first-card" class="adoption-search-card">
                    <div id="adoption-search-favorite-root" class="adoption-search-favorite">
                      <span class="adoption-search-favorite-placeholder" data-adoption-search-parser-loading aria-hidden="true">&#9825;</span>
                    </div>
                    <a id="adoption-search-first-card-link" class="adoption-search-card-link" href="/pet-adoption/search">
                      <img id="adoption-search-lcp-image" src="/images/adoption-search-dog-placeholder.webp" alt="Pet available for adoption" width="828" height="828" loading="eager" decoding="async" fetchpriority="high">
                      <div class="adoption-search-card-copy">
                        <h3 id="adoption-search-pet-name" class="heading-xs">Pet available for adoption</h3>
                        <p id="adoption-search-pet-details"></p>
                        <p id="adoption-search-pet-location"></p>
                      </div>
                    </a>
                  </section>
                  <div id="adoption-search-grid-root" class="adoption-search-grid-portal"></div>
                </div>
                <div id="adoption-search-pagination-root"></div>
              </div>
            </div>
          </section>
          </main>
          <div id="adoption-search-dialogs-root"></div>
        </div>
        <div id="adoption-search-react-root" class="adoption-search-only"></div>
      </div>
      <div id="default-shell">
      <div class="skeleton-header">
        <div class="skeleton-logo"></div>
      </div>
      <div class="skeleton-hero">
        <div class="skeleton-content">
          <p style="margin: 0 0 8px; color: #6b7280; font: 500 14px/1.4 system-ui, -apple-system, sans-serif;">
            Loading PetPlace
          </p>
          <div class="skeleton-title"></div>
          <div class="skeleton-text"></div>
        </div>
      </div>
      <div class="skeleton-info"></div>
      </div>
    </div>
    <script>
      (() => {
        if (!document.documentElement.classList.contains("adoption-detail") &&
            !document.documentElement.classList.contains("adoption-search")) return;

        const menuButton = document.getElementById("adoption-fast-menu-button");
        const menu = document.getElementById("adoption-fast-mobile-menu");
        const menuClose = document.getElementById("adoption-fast-mobile-menu-close");
        const mobileSearchButton = document.getElementById("adoption-fast-mobile-search");
        const searchButton = document.getElementById("adoption-fast-search-button");
        const searchOverlay = document.getElementById("adoption-fast-search-overlay");
        const searchClose = document.getElementById("adoption-fast-search-close");
        const banner = document.getElementById("adoption-fast-banner");
        const bannerClose = document.getElementById("adoption-fast-banner-close");
        const heroImage = document.getElementById("adoption-hero-image");

        if (document.documentElement.classList.contains("adoption-search")) {
          const params = new URLSearchParams(window.location.search);
          const animalType = params.get("filterAnimalType") || "Any";
          const zipPostal = params.get("zipPostal") || "";
          const heading = document.getElementById("adoption-search-heading");

          if (heading) {
            heading.textContent = `${animalType === "Any" ? "Any animal" : animalType}s for adoption near ${zipPostal}`;
          }
        }

        const announceHeroReady = () => {
          if (window.__petplaceAdoptionLcpReady) return;
          window.requestAnimationFrame(() => {
            window.__petplaceAdoptionLcpReady = true;
            window.dispatchEvent(new Event("petplace:adoption-lcp-ready"));
          });
        };

        if (heroImage instanceof HTMLImageElement && heroImage.complete) {
          announceHeroReady();
        } else {
          heroImage?.addEventListener("load", announceHeroReady, { once: true });
        }

        const setMenuOpen = (isOpen) => {
          if (!menu) return;
          menu.hidden = !isOpen;
          menuButton?.setAttribute("aria-expanded", String(isOpen));
          document.body.style.overflow = isOpen ? "hidden" : "";
          if (isOpen) menuClose?.focus();
          else menuButton?.focus();
        };

        menuButton?.addEventListener("click", () => setMenuOpen(true));
        menuClose?.addEventListener("click", () => setMenuOpen(false));

        const setSearchOpen = (isOpen) => {
          if (!searchOverlay) return;
          searchOverlay.hidden = !isOpen;
          searchButton?.setAttribute("aria-expanded", String(isOpen));
          if (isOpen) searchOverlay.querySelector("input")?.focus();
        };

        searchButton?.addEventListener("click", () => setSearchOpen(true));
        mobileSearchButton?.addEventListener("click", () => {
          setMenuOpen(false);
          setSearchOpen(true);
        });
        searchClose?.addEventListener("click", () => setSearchOpen(false));
        searchOverlay?.addEventListener("click", (event) => {
          if (event.target === searchOverlay) setSearchOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          if (menu && !menu.hidden) setMenuOpen(false);
          else setSearchOpen(false);
        });

        if (sessionStorage.getItem("hidePromoManually") === "true") {
          if (banner) banner.hidden = true;
        }
        bannerClose?.addEventListener("click", () => {
          sessionStorage.setItem("hidePromoManually", "true");
          if (banner) banner.hidden = true;
        });
      })();
    </script>
    <script>
      let applicationStarted = false;
      const loadApplicationStyles = () => {
        const isViteDevelopment = Array.from(document.scripts).some((script) =>
          script.src.includes("/@vite/client")
        );
        if (isViteDevelopment) return Promise.resolve();

        const existing = document.querySelector("link[data-petplace-application-styles]");
        if (existing instanceof HTMLLinkElement) {
          existing.rel = "stylesheet";
          existing.removeAttribute("as");

          if (existing.dataset.loaded === "true" || existing.sheet) {
            return Promise.resolve();
          }

          return new Promise((resolve, reject) => {
            existing.addEventListener("load", () => {
              window.requestAnimationFrame(resolve);
            }, { once: true });
            existing.addEventListener("error", reject, { once: true });
          });
        }

        return new Promise((resolve, reject) => {
          const stylesheet = document.createElement("link");
          stylesheet.rel = "stylesheet";
          stylesheet.href = "/assets/react-main.css";
          stylesheet.dataset.petplaceApplicationStyles = "true";
          stylesheet.addEventListener("load", resolve, { once: true });
          stylesheet.addEventListener("error", reject, { once: true });
          document.head.appendChild(stylesheet);
        });
      };

      const startApplication = async () => {
        if (applicationStarted) return;
        applicationStarted = true;
        await loadApplicationStyles();
        const isViteDevelopment = Array.from(document.scripts).some((script) =>
          script.src.includes("/@vite/client")
        );
        const applicationModule = isViteDevelopment
          ? "/src/main.tsx"
          : "/assets/react-main.min.js";
        await import(applicationModule);
      };

      if (document.documentElement.classList.contains("adoption-detail")) {
        if (window.__petplaceAdoptionLcpReady) {
          void startApplication();
        } else {
          window.addEventListener("petplace:adoption-lcp-ready", () => {
            void startApplication();
          }, { once: true });
        }
      } else if (document.documentElement.classList.contains("adoption-search")) {
        if (window.__petplaceAdoptionSearchLcpReady) {
          void startApplication();
        } else {
          window.addEventListener("petplace:adoption-search-lcp-ready", () => {
            void startApplication();
          }, { once: true });
          window.setTimeout(() => {
            void startApplication();
          }, 5000);
        }
      } else {
        void startApplication();
      }
    </script>
  </body>
</html>
