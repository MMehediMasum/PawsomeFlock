---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const posts = await getCollection('blog');
const categories = [...new Set(posts.flatMap((post) => post.data.categories))].sort();
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links" id="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<div class="dropdown">
				<button
					id="categories-trigger"
					class="dropdown-trigger"
					type="button"
					aria-haspopup="true"
					aria-expanded="false"
				>
					Categories
				</button>
				<ul id="categories-menu" class="dropdown-menu">
					{
						categories.map((category) => (
							<li>
								<a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}/`}>
									{category}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="header-actions">
			<button id="theme-toggle" aria-label="Toggle dark mode" type="button">
				<span id="theme-icon">🌙</span>
			</button>
			<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" type="button">
				<span></span><span></span><span></span>
			</button>
		</div>
	</nav>
</header>
<script>
	const themeButton = document.getElementById('theme-toggle');
	const themeIcon = document.getElementById('theme-icon');

	function syncIcon() {
		const current = document.documentElement.getAttribute('data-theme');
		if (themeIcon) themeIcon.textContent = current === 'dark' ? '☀️' : '🌙';
	}
	syncIcon();

	themeButton?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme');
		const next = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
		syncIcon();
	});

	const catTrigger = document.getElementById('categories-trigger');
	const catMenu = document.getElementById('categories-menu');

	catTrigger?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = catMenu?.classList.toggle('open');
		catTrigger.setAttribute('aria-expanded', String(!!isOpen));
	});

	document.addEventListener('click', () => {
		catMenu?.classList.remove('open');
		catTrigger?.setAttribute('aria-expanded', 'false');
	});

	const mobileToggle = document.getElementById('mobile-menu-toggle');
	const internalLinks = document.getElementById('internal-links');

	mobileToggle?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = internalLinks?.classList.toggle('mobile-open');
		mobileToggle.setAttribute('aria-expanded', String(!!isOpen));
		mobileToggle.classList.toggle('active', !!isOpen);
	});

	internalLinks?.addEventListener('click', (e) => {
		const target = e.target;
		if (target instanceof HTMLElement && target.tagName === 'A') {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});

	document.addEventListener('click', (e) => {
		if (
			internalLinks?.classList.contains('mobile-open') &&
			!internalLinks.contains(e.target) &&
			e.target !== mobileToggle
		) {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.internal-links > :global(a) {
		position: relative;
		padding: 1em 0.5em;
		margin-left: 10px;
		color: rgb(var(--black));
		text-decoration: none;
		text-transform: uppercase;
		font-weight: 700;
		font-size: 0.85em;
		opacity: 0.7;
		transition: opacity 0.2s ease;
	}
	.internal-links > :global(a.active) {
		opacity: 1;
	}
	.internal-links > :global(a::after) {
		content: '';
		position: absolute;
		left: 0.5em;
		right: 0.5em;
		bottom: 0.75em;
		height: 2px;
		background: rgb(var(--gray));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	.internal-links > :global(a:hover::after) {
		transform: scaleX(1);
	}
	.internal-links > :global(a.active::after) {
		transform: scaleX(1);
		background: var(--accent);
	}
	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		background: none;
		border: none;
		font-family: inherit;
		cursor: pointer;
		padding: 1em 0.5em;
		margin-left: 10px;
		color: rgb(var(--black));
		text-transform: uppercase;
		font-weight: 700;
		font-size: 0.85em;
		opacity: 0.7;
		transition: opacity 0.2s ease;
	}
	.dropdown-trigger:hover,
	.dropdown-trigger[aria-expanded='true'] {
		opacity: 1;
	}
	.dropdown-menu {
		position: absolute;
		top: 100%;
		left: 10px;
		min-width: 160px;
		margin: 0;
		padding: 0.5em 0;
		list-style: none;
		background: white;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
		z-index: 20;
	}
	.dropdown-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.dropdown-menu li {
		margin: 0;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.5em 1em;
		color: rgb(var(--black));
		text-decoration: none;
		text-transform: none;
		font-weight: 400;
		font-size: 1em;
	}
	.dropdown-menu a:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}
	.header-actions {
		display: flex;
		align-items: center;
	}
	#theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1.3em;
		padding: 0.5em;
		line-height: 1;
	}
	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
		margin-left: 0.3em;
	}
	.mobile-menu-toggle span {
		display: block;
		width: 20px;
		height: 2px;
		background: rgb(var(--black));
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.mobile-menu-toggle.active span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle.active span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}
	:root[data-theme='dark'] header {
		background: #14161c;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 40%);
	}
	:root[data-theme='dark'] .dropdown-menu {
		background: #14161c;
	}
	:root[data-theme='dark'] .mobile-menu-toggle span {
		background: rgb(var(--black));
	}

	@media (max-width: 640px) {
		nav {
			flex-wrap: wrap;
		}
		.mobile-menu-toggle {
			display: flex;
		}
		.internal-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			order: 3;
			padding: 0.5em 0 1em 0;
		}
		.internal-links.mobile-open {
			display: flex;
		}
		.internal-links > :global(a) {
			margin-left: 0;
			padding: 0.8em 0;
		}
		.internal-links > :global(a::after) {
			display: none;
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-trigger {
			width: 100%;
			text-align: left;
			margin-left: 0;
			padding: 0.8em 0;
		}
		.dropdown-menu {
			position: static;
			box-shadow: none;
			opacity: 1;
			visibility: visible;
			transform: none;
			display: none;
			padding-left: 1em;
		}
		.dropdown-menu.open {
			display: block;
		}
	}
</style>