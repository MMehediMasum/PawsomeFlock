---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
 
type Props = CollectionEntry<'blog'>['data'] & { readingTime?: number };
 
const { title, description, pubDate, updatedDate, heroImage, author, categories, readingTime } =
	Astro.props;
const authorEntry = author ? await getEntry('authors', author) : undefined;
---
 
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-box {
				display: flex;
				align-items: center;
				gap: 1em;
				margin: 1.5em 0;
				padding: 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
			}
			.author-box img {
				width: 48px;
				height: 48px;
				border-radius: 50%;
			}
			.author-box .name {
				font-weight: bold;
				margin: 0;
			}
			.author-box .bio {
				margin: 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.categories {
				margin: 1em 0;
			}
			.categories a {
				display: inline-block;
				margin-right: 0.5em;
				padding: 0.2em 0.6em;
				border-radius: 6px;
				background: rgb(var(--gray-light));
				text-decoration: none;
				font-size: 0.85em;
			}
		</style>
	</head>
 
	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="date">
							<FormattedDate date={pubDate} />
							{readingTime && <span> ~ {readingTime} min read</span>}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<hr />
					</div>
 
					{
						heroImage && (
							<div class="hero-image">
								<Image width={1020} height={510} src={heroImage} alt="" />
							</div>
						)
					}
 
					<slot />
 
					<hr />
 
					{
						authorEntry && (
							<div class="author-box">
								{authorEntry.data.avatar && (
									<img src={authorEntry.data.avatar} alt={authorEntry.data.name} />
								)}
								<div>
									<p class="name">By {authorEntry.data.name}</p>
									<p class="bio">{authorEntry.data.bio}</p>
								</div>
							</div>
						)
					}
 
					{
						categories && categories.length > 0 && (
							<div class="categories">
								{categories.map((category) => (
									<a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}/`}>
										{category}
									</a>
								))}
							</div>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
